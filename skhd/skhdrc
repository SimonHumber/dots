#changing window focus
alt+shift - j : yabai -m window --focus south
alt+shift - k : yabai -m window --focus north
alt+shift - h : yabai -m window --focus west
alt+shift - l : yabai -m window --focus east

#modifying layout of screen
alt+shift - s : yabai -m space --rotate 270
alt+shift - d : yabai -m space --mirror y-axis
alt+shift - w : yabai -m space --mirror x-axis
alt+shift - p : yabai -m window --toggle float --grid 4:4:1:1:2:2
alt+shift - m : yabai -m window --toggle zoom-fullscreen
alt+shift - n : yabai -m window --toggle zoom-parent

alt+shift - o : yabai -m window --space next --focus
alt + shift - u : yabai -m window --space prev --focus

alt + shift - g : yabai --start-service
alt + shift - f : yabai --stop-service

#rotate big window when 3 windows are on screen
alt+shift - r : yabai -m window first --swap next && yabai -m window first --swap last
